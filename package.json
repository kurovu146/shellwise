{
  "name": "shellwise",
  "version": "0.4.2",
  "description": "Smart command history with inline auto-suggest and fuzzy search for your terminal",
  "type": "module",
  "bin": {
    "shellwise": "./src/index.ts",
    "sw": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "scripts/*.sh",
    "scripts/*.ts"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/sw",
    "test": "bun test",
    "postinstall": "bun scripts/install-hook.ts setup || node -e \"process.platform==='win32'||require('child_process').spawnSync('bash',['scripts/setup.sh'],{stdio:'inherit'})\" || exit 0",
    "preuninstall": "bun scripts/install-hook.ts uninstall || node -e \"process.platform==='win32'||require('child_process').spawnSync('bash',['scripts/uninstall.sh'],{stdio:'inherit'})\" || exit 0"
  },
  "keywords": [
    "shell",
    "history",
    "fuzzy-search",
    "terminal",
    "cli",
    "autosuggest",
    "zsh",
    "bash",
    "command-history",
    "shellwise"
  ],
  "author": "Vu Duc Tuan",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurovu146/shellwise"
  },
  "homepage": "https://github.com/kurovu146/shellwise#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
